{
	"name": "r2-webdav",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "vite build",
		"dev": "pnpm build && wrangler dev",
		"start": "pnpm build && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
		"lint": "node scripts/kumo-lint.mjs",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "*",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"prettier": "^3.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.0.4",
		"vite": "^8.3.5",
		"vite-plugin-singlefile": "^2.3.4",
		"wrangler": "^4.15.2"
	},
	"type": "module",
	"dependencies": {
		"@cloudflare/kumo": "^2.15.0",
		"@xmldom/xmldom": "^0.8.11",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"packageManager": "pnpm@12.14.0"
